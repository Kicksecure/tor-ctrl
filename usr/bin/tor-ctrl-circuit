#!/bin/bash

## Copyright (C) 2021 - 2022 nyxnor <nyxnor@protonmail.com>
## Copyright (C) 2013 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@riseup.net>
## See the file COPYING for copying conditions.

## The colour palette comes from the sourced get_colors.sh, which shellcheck
## cannot follow in an isolated checkout.
# shellcheck disable=SC2154

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/strings.bsh
## Sibling repo: absent in an isolated CI checkout, so shellcheck cannot
## follow it there. The source= path above still documents where it lives.
# shellcheck disable=SC1091
source /usr/libexec/helper-scripts/strings.bsh

## sets: has
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/has.sh
# shellcheck disable=SC1091
source /usr/libexec/helper-scripts/has.sh

## sets: pad_right, pad_left
# shellcheck source=../libexec/tor-ctrl/pad.bsh
## Resolved relative to this script, which shellcheck does not do from
## the repository root the gate runs in. R-080 requires the relative
## spelling, so the path documents the location and SC1091 is disabled.
# shellcheck disable=SC1091
source /usr/libexec/tor-ctrl/pad.bsh

me="${0##*/}"

## Assigned only when the matching option is given, and every read below is a
## '[ -n ]' test, so empty is what these expanded to before strict mode.
tor_control_socket=""
tor_password=""
machine_mode=""

## sets: nocolor, bold, yellow and the rest of the palette, already emptied
## when the terminal cannot render them -- no TERM, TERM=dumb, NO_COLOR, or
## stderr not a terminal. Replaces two inline ANSI definitions.
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/get_colors.sh
## Sibling repo: absent in an isolated CI checkout, so shellcheck cannot follow
## it there. The source= path above still documents where it lives.
# shellcheck disable=SC1091
source /usr/libexec/helper-scripts/get_colors.sh

## get_colors.sh decides by testing fd 2 (stderr) -- see its '! test -t 2'. This
## script writes the palette to STDOUT, so a redirected report or a pipe into
## another program would receive ANSI bytes whenever stderr merely happened to
## be a terminal. Gate on the stream the colours actually land on.
##
## This does not reimplement the palette: it still comes from get_colors.sh.
## It applies the same tty rule that file applies, to the correct descriptor.
if [ ! -t 1 ]; then
   yellow=""
   nocolor=""
fi


usage(){
  printf '%s\n' "usage: ${me} [-s socket] [-p password]

  -s [socket]    tor's control socket
                 notice: tcp: [addr:]port: 9051, 127.0.0.1:9051
                 notice: unix: [unix:]path: /run/tor/control,
                         unix:/run/tor/control
                 default: 9051

  -p [pwd]       use password [pwd] instead of Tor's control_auth_cookie
                 default: not used

  -m             machine mode
                 notice: script informational and warning messages won't be
                         printed to stdout
                 default: not set
"
  exit 1
}

error_msg(){
  printf '%s\n' "${me}: [error] ${1}" >&2
  exit 1
}

list_circuits(){
  # shellcheck disable=SC2086
  circuit_all="$(tor-ctrl -c "GETINFO circuit-status" ${cli_args})"
  ## '%s', not '%b': get_colors.sh stores real escape BYTES, so there is
  ## nothing left for %b to decode -- and %b would additionally interpret any
  ## backslash that appeared in the message text.
  printf '%s\n' "${yellow}${me}: [warn] Do not share this information publicly, it could deanonymize yourself.${nocolor}"
  circuit_all="$(printf '%s\n' "${circuit_all}" | sed "/250 OK/d;/250+circuit-status=/d;/250 closing connection/d")"
  printf '%s\n' "${circuit_all}" | while IFS=$'\n' read -r circuit || [ -n "${circuit}" ]; do
    circuit_id="$(printf '%s\n' "${circuit}" | cut -d " " -f1)"
    circuit_status="$(printf '%s\n' "${circuit}" | cut -d " " -f2)"
    circuit_path="$(printf '%s\n' "${circuit}" | cut -d " " -f3)"
    circuit_purpose="$(printf '%s\n' "${circuit}" | cut -d " " -f5 | sed "s/PURPOSE=//")"
    [ -z "${circuit_status}" ] && break
    if [ "${circuit_status}" = "BUILT" ]; then
      printf '%s\n' "Circuit: ${circuit_id}, status: ${circuit_status}, purpose: ${circuit_purpose}"
      hop=0
      for relay in $(printf '%s\n' "${circuit_path}" | tr "," " "); do
        hop=$((hop+1))
        relay="$(printf '%s\n' "${relay}" | tr -d "$" | tr "~" " ")"
        relay_fingerprint="$(printf '%s\n' "${relay}" | cut -d " " -f1)"
        relay_nickname="$(printf '%s\n' "${relay}" | cut -d " " -f2)"
        # shellcheck disable=SC2086
        relay_status="$(tor-ctrl -c "GETINFO ns/id/${relay_fingerprint}" ${cli_args})"
        relay_host="$(printf '%s\n' "${relay_status}" | grep -- "^r " | cut -d " " -f7 || true)"
        relay_bandwidth="$(printf '%s\n' "${relay_status}" | grep -- "^w " | sed "s/w Bandwidth=//;s/\\r//" || true)"
        if ! is_whole_number "${relay_bandwidth}"; then
          relay_bandwidth=0
        fi
        relay_bandwidth="$((relay_bandwidth*512/1024/1024)) MiB/s"
        # shellcheck disable=SC2086
        relay_locale="$(tor-ctrl -c "GETINFO ip-to-country/${relay_host}" ${cli_args})"
        ## '|| true': tor omits the country line for a relay whose IP it
        ## cannot map, and grep then exits 1. Before strict mode that left
        ## relay_locale empty and the row still printed; under errexit it
        ## aborted the ENTIRE listing partway through.
        relay_locale="$(printf '%s\n' "${relay_locale}" | grep -F -- "250-ip-to-country/${relay_host}=" | sed "s/.*=//;s/\\r//" || true)"
        ## Columns padded in shell rather than with a printf field width; see
        ## the note in pad.bsh. Widths match the previous
        ## '%1s. %-40s %-15s %-19s (%-2s) %9s' exactly.
        hop_column="$(pad_left "${hop}" 1)"
        fingerprint_column="$(pad_right "${relay_fingerprint}" 40)"
        host_column="$(pad_right "${relay_host}" 15)"
        nickname_column="$(pad_right "${relay_nickname}" 19)"
        locale_column="$(pad_right "${relay_locale}" 2)"
        bandwidth_column="$(pad_left "${relay_bandwidth}" 9)"
        printf '%s\n' "${hop_column}. ${fingerprint_column} ${host_column} ${nickname_column} (${locale_column}) ${bandwidth_column}"
      done
      printf '%s\n' ""
    fi
  done
  ## '%s', not '%b': get_colors.sh stores real escape BYTES, so there is
  ## nothing left for %b to decode -- and %b would additionally interpret any
  ## backslash that appeared in the message text.
  printf '%s\n' "${yellow}${me}: [warn] Do not share this information publicly, it could deanonymize yourself.${nocolor}"
}

has tor-ctrl || error_msg "Install tor-ctrl"

while getopts ":s:p:mh" Option; do
  case ${Option} in
    s)
      tor_control_socket="${OPTARG}"
      ;;
    p)
      tor_password="${OPTARG}"
      ;;
    m)
      machine_mode=1
      ;;
    h|*)
      usage
      ;;
  esac
done

cli_args=""
[ -n "${tor_control_socket}" ] && cli_args="${cli_args} -s ${tor_control_socket}"
[ -n "${tor_password}" ] && cli_args="${cli_args} -p ${tor_password}"
[ -n "${machine_mode}" ] && cli_args="${cli_args} -m"

## set default values
: "${machine_mode:=0}"

## only to get which socket it successfully connects
## cli_args is a pre-split option string, so the expansion must NOT be quoted.
##
## The grep finds nothing when the notice is suppressed, which is not an error --
## but a bare '|| true' also swallows a FAILING tor-ctrl query, which is the one
## thing this probe exists to report on. Capture PIPESTATUS instead and tolerate
## only the documented case: tor-ctrl succeeded and grep matched nothing.
probe_status=()
# shellcheck disable=SC2086
tor-ctrl -c "GETINFO circuit-status" ${cli_args} | grep -- "connecting to socket with command" || probe_status=("${PIPESTATUS[@]}")

if [ "${#probe_status[@]}" -gt 0 ]; then
  if [ "${probe_status[0]}" != "0" ]; then
    error_msg "tor-ctrl could not query the controller (exit ${probe_status[0]})."
  fi
  ## 1 is grep's "no match"; anything else is a real grep failure.
  if [ "${probe_status[1]}" != "1" ]; then
    error_msg "reading the socket notice failed (grep exit ${probe_status[1]})."
  fi
fi

list_circuits
